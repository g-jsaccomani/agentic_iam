# ==============================================================================
# Agentic IAM Accelerator — Clean-Slate Multi-User Configuration
# Consultative IAM Posture Assessment, Modernization, and Least-Privilege Engine
# ==============================================================================

# AI Compute Plane (Vertex AI Global Engine ONLY — Zero Target Org Permissions)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-pro-preview-customtools

# Access Control: comma-separated email domains allowed to sign in.
# "*" allows ANY Google account; use it only for a throwaway local test.
ALLOWED_IAP_DOMAINS=your-company.example
# OAuth2 / OIDC & Cloud Run IAP Authentication Hardening
IAM_OAUTH_CLIENT_ID=
# OAuth2 client IDs whose access tokens are accepted (comma-separated). The default is the public
# gcloud CLI client (`gcloud auth print-access-token`). Add another client ID only if you know which
# application it belongs to: every ID listed here widens who can mint a token this service accepts.
IAM_ALLOWED_TOKEN_AZP=32555940559.apps.googleusercontent.com
IAM_IAP_AUDIENCE=
IAM_PUBLIC_ORIGIN=

# Target Inspection Plane — Intentionally Blank (Connected per-user via Impersonation / OAuth)
GCP_ORGANIZATION_ID=
GCP_ORGANIZATION_DOMAIN=
GCP_ASSESSMENT_SCOPE=

# Workspace persistence (every stored document is AES-256-GCM encrypted per user).
# The consultant chooses the retention per customer when connecting; these are the default and the ceiling.
# 0 = persist nothing (session only).
IAM_WORKSPACE_RETENTION_DAYS=30
IAM_WORKSPACE_MAX_RETENTION_DAYS=365

# Optional runtime-SA token auto-renew. Keep false unless a customer explicitly agrees to grant the platform
# runtime Service Account TokenCreator on their assessor SA (standing access until they remove it).
IAM_ENABLE_PERSISTENT_DELEGATION=false

# Browser session cookie lifetime in seconds (default 8 hours)
IAM_SESSION_TTL_SECONDS=28800

# Runtime Configuration
PORT=8080
EXPORT_DIR=exports
